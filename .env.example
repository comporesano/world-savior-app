# Секрет для подписи JWT — обязательно смените в production
JWT_SECRET=change-me-to-a-long-random-string

# Время жизни токенов
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Путь к файлу SQLite (по умолчанию data/ecosavior.db)
# DATABASE_URL=sqlite:///data/ecosavior.db

# Лимит запросов на эндпоинты /api/v1/auth/*
AUTH_RATE_LIMIT=30/minute
# RATE_LIMIT_ENABLED=0 — отключить лимиты (например, в тестах)

# CORS: список источников через запятую (пусто = разрешены все)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
